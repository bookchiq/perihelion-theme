{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1080px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"customGradient": false,
			"link": true,
			"text": true,
			"background": true,
			"palette": [
				{ "name": "Sienna",       "slug": "sienna",       "color": "#9C4B30" },
				{ "name": "Sienna Hover", "slug": "sienna-hover", "color": "#803D26" },
				{ "name": "Ink",          "slug": "ink",          "color": "#2A2A28" },
				{ "name": "Slate",        "slug": "slate",        "color": "#5A5A55" },
				{ "name": "Sage",         "slug": "sage",         "color": "#9DA67E" },
				{ "name": "Honey",        "slug": "honey",        "color": "#D69A3C" },
				{ "name": "Paper",        "slug": "paper",        "color": "#F7F3ED" },
				{ "name": "Paper Warm",   "slug": "paper-warm",   "color": "#F1ECE2" },
				{ "name": "Rule",         "slug": "rule",         "color": "rgba(156, 75, 48, 0.15)" }
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": false,
			"dropCap": false,
			"lineHeight": true,
			"letterSpacing": true,
			"textDecoration": true,
			"textTransform": true,
			"fontFamilies": [
				{
					"name": "Heading",
					"slug": "heading",
					"fontFamily": "'Fraunces', Georgia, 'Times New Roman', serif"
				},
				{
					"name": "Body",
					"slug": "body",
					"fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif"
				}
			],
			"fontSizes": [
				{ "name": "Caption", "slug": "caption", "size": "0.875rem" },
				{ "name": "Body",    "slug": "body",    "size": "1rem" },
				{ "name": "Lead",    "slug": "lead",    "size": "1.1875rem", "fluid": { "min": "1.0625rem", "max": "1.1875rem" } },
				{ "name": "H3",      "slug": "h3",      "size": "1.25rem",   "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "name": "H2",      "slug": "h2",      "size": "1.75rem",   "fluid": { "min": "1.5rem",   "max": "1.75rem" } },
				{ "name": "H1",      "slug": "h1",      "size": "2.5rem",    "fluid": { "min": "2rem",     "max": "2.5rem" } },
				{ "name": "Display", "slug": "display", "size": "3.75rem",   "fluid": { "min": "2.5rem",   "max": "3.75rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingScale": { "steps": 0 },
			"units": [ "rem", "px", "em", "%", "vh", "vw" ],
			"spacingSizes": [
				{ "name": "2xs", "slug": "20", "size": "0.25rem" },
				{ "name": "xs",  "slug": "30", "size": "0.5rem" },
				{ "name": "s",   "slug": "40", "size": "1rem" },
				{ "name": "m",   "slug": "50", "size": "1.5rem" },
				{ "name": "l",   "slug": "60", "size": "2.5rem" },
				{ "name": "xl",  "slug": "70", "size": "4rem" },
				{ "name": "2xl", "slug": "80", "size": "6rem" }
			]
		},
		"custom": {
			"surface": {
				"borderRadius": {
					"sm": "4px",
					"md": "8px",
					"lg": "12px"
				},
				"shadow": {
					"soft": "0 1px 3px rgba(42, 42, 40, 0.04), 0 2px 8px rgba(42, 42, 40, 0.04)",
					"lift": "0 2px 6px rgba(42, 42, 40, 0.06), 0 8px 20px rgba(42, 42, 40, 0.06)"
				},
				"transition": {
					"fast": "0.15s ease",
					"default": "0.18s ease",
					"slow": "0.3s ease"
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--50)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--50)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": { "text": "var(--wp--preset--color--sienna-hover)" }
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--h1)",
					"fontWeight": "500",
					"lineHeight": "1.2",
					"letterSpacing": "-0.015em"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--h2)",
					"fontWeight": "500",
					"lineHeight": "1.2",
					"letterSpacing": "-0.015em"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--h3)",
					"fontWeight": "500",
					"lineHeight": "1.3"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--lead)",
					"fontWeight": "500",
					"lineHeight": "1.4"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--body)",
					"fontWeight": "600",
					"textTransform": "uppercase",
					"letterSpacing": "0.05em"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--caption)",
					"fontWeight": "500",
					"textTransform": "uppercase",
					"letterSpacing": "0.12em"
				},
				"color": { "text": "var(--wp--preset--color--slate)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--sienna)",
					"text": "var(--wp--preset--color--paper)"
				},
				"border": { "radius": "8px" },
				"spacing": {
					"padding": {
						"top": "0.55em",
						"right": "1.15em",
						"bottom": "0.55em",
						"left": "1.15em"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--body)",
					"fontWeight": "500",
					"letterSpacing": "0.01em"
				},
				":hover": {
					"color": { "background": "var(--wp--preset--color--sienna-hover)" }
				},
				":focus": {
					"color": { "background": "var(--wp--preset--color--sienna-hover)" }
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--slate)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--caption)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--h3)",
					"fontWeight": "500",
					"letterSpacing": "-0.015em",
					"lineHeight": "1.1",
					"textDecoration": "none"
				},
				"color": { "text": "var(--wp--preset--color--ink)" },
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--ink)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--h1)",
					"fontWeight": "500",
					"lineHeight": "1.2",
					"letterSpacing": "-0.015em"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontStyle": "italic",
					"fontSize": "var(--wp--preset--font-size--h3)",
					"lineHeight": "1.5"
				},
				"border": {
					"left": {
						"width": "2px",
						"style": "solid",
						"color": "var(--wp--preset--color--sienna)"
					}
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--50)"
					}
				}
			},
			"core/separator": {
				"color": { "background": "var(--wp--preset--color--rule)" },
				"border": { "color": "var(--wp--preset--color--rule)" }
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-app",
			"title": "App layout",
			"postTypes": [ "page" ]
		}
	],
	"templateParts": [
		{ "name": "header-marketing", "title": "Header (marketing)", "area": "header" },
		{ "name": "header-app",       "title": "Header (app)",       "area": "header" },
		{ "name": "footer-marketing", "title": "Footer (marketing)", "area": "footer" },
		{ "name": "footer-app",       "title": "Footer (app)",       "area": "footer" }
	]
}
